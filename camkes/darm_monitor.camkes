import <interfaces/DarmInterface.camkes>;

component StochasticAI {
    uses DarmInterface monitor_ep;
}

component DarmMonitor {
    provides DarmInterface monitor_ep;
    uses ActuatorInterface actuator_ep;
}

component HardwareActuator {
    provides ActuatorInterface actuator_ep;
}

assembly {
    composition {
        component StochasticAI ai;
        component DarmMonitor darm;
        component HardwareActuator hw;

        connection seL4RPCCall ai_to_darm(from ai.monitor_ep, to darm.monitor_ep);
        connection seL4RPCCall darm_to_hw(from darm.actuator_ep, to hw.actuator_ep);
    }
    configuration {
        hw.mmio_region_paddr = 0x3F200000;
        hw.mmio_region_size  = 0x1000;
    }
}
